# ─────────────────────────────────────────────────────────────
# CortexFlow environment — copy to `.env` and edit secrets.
# NEVER commit `.env`. All values here are dev defaults.
# ─────────────────────────────────────────────────────────────

ENV=dev
APP_NAME=CortexFlow
SECRET_KEY=change-me-to-a-64-char-random-string-use-openssl-rand-hex-32
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex
POSTGRES_DB=cortexflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cortex:cortex@postgres:5432/cortexflow
DATABASE_SYNC_URL=postgresql://cortex:cortex@postgres:5432/cortexflow

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# ── RabbitMQ (Celery) ─────────────────────────────────────────
RABBITMQ_URL=amqp://cortex:cortex@rabbitmq:5672//
CELERY_BROKER_URL=amqp://cortex:cortex@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Qdrant (vectors) ──────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cortexflow_chunks
QDRANT_VECTOR_SIZE=768

# ── Neo4j (knowledge graph) ───────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cortexneo4j

# ── MinIO (S3 object storage) ─────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cortexminio
MINIO_SECRET_KEY=cortexminio
MINIO_BUCKET=cortexflow
MINIO_SECURE=false

# ── ElasticSearch (search) ────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── LLM: Ollama (local, default) ──────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional cloud providers (LiteLLM router keys) — leave blank to stay local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── OAuth providers ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=no-reply@cortexflow.io

# ── Billing (Stripe) ──────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
